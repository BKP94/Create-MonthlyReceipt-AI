# ========================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามเครื่องตัวเอง
# (.env.local ไม่ขึ้น git — ดู .gitignore)
#
# ปกติตอนพัฒนาบนเครื่องไม่ต้องตั้งอะไรเลย
# ค่าเหล่านี้ใช้ตอน build เพื่อ deploy เท่านั้น
# ========================================================

# path ที่แอปถูกเสิร์ฟ — ต้องลงท้ายด้วย /
# GitHub Pages: /<ชื่อ repo>/    ปกติ (โดเมนตัวเอง / localhost): /
# บน GitHub Actions ค่านี้ถูกตั้งให้อัตโนมัติแล้ว ไม่ต้องแก้
VITE_BASE_PATH=/

# URL ของ backend — ใส่แค่ origin ไม่ต้องมี /api ต่อท้าย
# ว่างไว้ = เรียก /api บนโดเมนเดียวกัน (ใช้ dev proxy ตอน pnpm dev)
# ตัวอย่าง: VITE_API_URL=https://finance-api-beer.azurewebsites.net
VITE_API_URL=
